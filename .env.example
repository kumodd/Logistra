# Server-only Shiprocket API user credentials. Never prefix these with NEXT_PUBLIC_.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Temporary fallback when live credentials are unavailable. Live Shiprocket quotes take precedence.
# Set to false to require live quotes.
STANDARD_RATE_ESTIMATES_ENABLED=true
STANDARD_LOGISTRA_ORIGIN_PINCODE=801103

# Keep the live Logistra comparison disabled until the facility and origin are verified.
LOGISTRA_FULFILMENT_ENABLED=false
LOGISTRA_ORIGIN_PINCODE=801103
LOGISTRA_FACILITY_VERIFIED=false

# Optional approved pricing JSON. Leave empty until commercial rates are approved.
# Example shape only; replace the fee object with approved amounts before enabling it:
# {"version":"...","effectiveDate":"YYYY-MM-DD","currency":"INR","gstTreatment":"exclusive","approvalStatus":"approved","publicDisplay":true,"fees":{}}
LOGISTRA_PRICING_CONFIG_JSON={"version":"dev-sample-1","effectiveDate":"2026-10-19","currency":"INR","gstTreatment":"exclusive","approvalStatus":"approved","publicDisplay":true,"fees":{"pickAndPackPerOrder":15,"packagingPerOrder":10,"storagePerOrder":5,"receivingPerOrder":4,"putawayPerOrder":3,"returnsPerOrder":20,"otherPerOrder":0,"fixedMonthly":5000,"inventoryTransferMonthly":2500}}
